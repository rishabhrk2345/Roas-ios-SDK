<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The SDK's privacy manifest. Xcode merges it into the host app's privacy
  report at archive time, and App Store Connect REFUSES an upload whose
  binary calls a "required reason" API that no manifest in the bundle
  declares (ITMS-91053). Until 0.1.10 this file did not exist, so every
  customer's first upload with the SDK linked would have been rejected for
  UserDefaults and file-timestamp calls that are ours, not theirs.

  Two things about what is declared here are deliberate and worth reading
  before editing:

  1. NSPrivacyTracking is TRUE with NO tracking domains. Reading the IDFA for
     cross-app ad attribution is tracking as ATT defines it, so declaring
     false would be a lie. But NSPrivacyTrackingDomains is what makes iOS
     DROP every request to a listed host when ATT is denied - and our
     collector is one host per deployment, often the customer's own
     first-party proxy path. Listing it would silence the install, session,
     event and purchase beacons for every user who declines the prompt,
     which is most of them, none of which carry the IDFA. The SDK enforces
     the boundary itself instead: the IDFA is read only after ATT grants,
     and is the ONLY tracking datum on the wire. Adjust's answer to the same
     problem is dedicated `consent.*` hosts that carry only IDFA-bearing
     traffic; if we ever split a tracking host out, it goes in this list.

  2. System boot time (`ProcessInfo.systemUptime`) is NOT declared, because
     0.1.10 stopped using it. Every approved reason for that API forbids
     sending the value off-device, and `uptime_seconds` went to the server as
     a device-farm signal. A manifest that declared 35F9.1 while shipping the
     value would be a false declaration. Android keeps the field.

  Data types are declared for what the SDK itself puts on the wire. Hashed
  email and phone count as email/phone under Apple's definitions ("including
  but not limited to a hashed email address"), and they are marked as
  tracking because the product can forward matched conversions, carrying
  those hashes, to Meta and Google - third-party advertising by definition.
-->
<dict>
    <key>NSPrivacyTracking</key>
    <true/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <dict>
            <!-- Storage.swift: visitor id, session state, the beacon queue. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <dict>
            <!-- The Documents directory's creation date (true install moment,
                 and the anchor that detects a backup-restored data container)
                 and the bundle's (last update). Both inside the app container,
                 which is what C617.1 covers. -->
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
    <key>NSPrivacyCollectedDataTypes</key>
    <array>
        <dict>
            <!-- IDFA (after ATT grants) and IDFV. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeDeviceID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>
        <dict>
            <!-- identify(email:) sends a SHA-256 of the normalised address. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeEmailAddress</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>
        <dict>
            <!-- identify(phone:) sends a SHA-256 of the E.164 number. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePhoneNumber</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>
        <dict>
            <!-- identify(customerUserId:) - the app's own account id. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeUserID</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <!-- track(): funnel events and their properties. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeProductInteraction</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <!-- verifyPurchase(): a StoreKit transaction id. The amount is
                 fetched server-side from Apple, never read on the device. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypePurchaseHistory</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <!-- The Apple Search Ads attribution token and click ids carried
                 by deferred / universal links. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeAdvertisingData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <true/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeThirdPartyAdvertising</string>
            </array>
        </dict>
        <dict>
            <!-- DeviceLocation: only when the host app already holds location
                 permission, and rounded to ~1.1 km before it leaves the
                 device. The SDK never prompts. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeCoarseLocation</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
            </array>
        </dict>
        <dict>
            <!-- Device context: model, OS build, screen, RAM, battery,
                 network type, VPN flag, integrity signals, SDK version. -->
            <key>NSPrivacyCollectedDataType</key>
            <string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
            <key>NSPrivacyCollectedDataTypeLinked</key>
            <true/>
            <key>NSPrivacyCollectedDataTypeTracking</key>
            <false/>
            <key>NSPrivacyCollectedDataTypePurposes</key>
            <array>
                <string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
                <string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
